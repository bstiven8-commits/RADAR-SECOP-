# Nombre público de la plataforma (cámbialo por el definitivo)
NEXT_PUBLIC_APP_NAME=Radar SECOP
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Socrata / datos.gov.co (opcional pero recomendado: sube el límite de consultas)
SOCRATA_TOKEN=

# Correo (Resend). EMAIL_FROM debe ser de un dominio verificado en Resend
RESEND_API_KEY=
EMAIL_FROM=Radar SECOP <alertas@tudominio.com>

# Correo de contacto que aparece en la política de datos
NEXT_PUBLIC_CONTACT_EMAIL=contacto@tudominio.com

# Secreto que protege /api/cron y firma los enlaces de baja (genera uno largo y aleatorio)
CRON_SECRET=

# Pagos con Wompi (https://comercios.wompi.co > Desarrolladores). En pruebas usa las llaves pub_test_...
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
